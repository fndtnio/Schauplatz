// Traffic light — the paint verb changes a color over time, the way
// move changes a position. Lamps snap (over defaults to 0); the sky
// panel fades (over) to show the other mode.
//
// The car stopping on red is authored correlation: the language has
// no causation, only a shared clock. The car and the light each
// follow their own schedule; the scene makes them LOOK obedient.

// the light: a post, a head, three lamps. "Off" is a dark grey.
box post size(0.15 2.6 0.15) at(3 1.3 0)
box head size(0.6 1.8 0.5) at(3 3.4 0) color(#1c1c1f)
sphere red_lamp   r(0.18) at(3 3.95 0.3) color(#e04a3a)   // starts lit
sphere amber_lamp r(0.18) at(3 3.4 0.3)  color(#3f3f42)
sphere green_lamp r(0.18) at(3 2.85 0.3) color(#3f3f42)

// one cycle: red 0-4, green 4-9, amber 9-11, red again
paint red_lamp   to(#3f3f42) start(4)
paint green_lamp to(#39c25c) start(4)
paint green_lamp to(#3f3f42) start(9)
paint amber_lamp to(#e0a33a) start(9)
paint amber_lamp to(#3f3f42) start(11)
paint red_lamp   to(#e04a3a) start(11)

// the road and a car that knows the timetable
box road size(26 0.02 2.6) at(0 0.01 1.6) color(#26262b)
box car size(1.8 0.7 1) at(-11 0.36 1.6) color(#3d7fa6)
move car to(1.2 0.36 1.6) over(3.2) ease(out)    // rolls up on red, stops at the line
move car to(12 0.36 1.6) start(4.6) over(3) ease(in)  // pulls away on green

// a sky panel fading from day to dusk: paint with over() lerps
box sky size(26 8 0.1) at(0 4 -4) color(#8db7d6)
paint sky to(#2b3350) start(2) over(9)

? distance(car red_lamp)
