// The study, as found. Model the claims, then interrogate the space.
theme noir  // one hard light, long shadows — the study at night

//
// Claim 1: the vase "fell off the shelf" and shattered where it was found.
//          The floor marker shows where the pieces actually were.
// Claim 2: the witness "watched it fall from the doorway."

box floor-mark size(0.4 0.02 0.4) at(2.5 0.01 1.5) color(crimson)

box desk     size(2 0.8 1) at(-2 0.4 -1.5) color(#8b5e3c)
box chair    size(0.5 0.9 0.5) in-front-of(desk) color(#6f4a2f)

box bookcase size(1.8 2.2 0.4) at(2 1.1 -2.2) color(#5b4a3a)
box shelf    size(1.4 0.08 0.35) at(2 1.6 -1.8) color(#7a6a55)   // mounted on the bookcase front
cylinder vase-was-here r(0.12) h(0.3) on(shelf) color(#7fb8c9)

box screen   size(1.6 1.7 0.1) at(1.5 0.85 0.6) color(#9c8a6a)   // folding divider
box doorway  size(0.9 2.1 0.15) at(0.5 1.05 3) color(#3d4250)

box rug      size(3 0.03 2) at(0.5 0.015 0.5) color(#7d5a5a)

// Claim 1: a falling vase lands below its shelf — the pieces were meters away.
? distance(vase-was-here floor-mark)

// Claim 2: could the witness even see the shelf from the doorway?
? sees(doorway vase-was-here)
? blocked-by(doorway vase-was-here)

// And the chair wasn't where the statement put it (it should block the desk):
? overlaps(chair desk)
