// MURDLE — starter template (later chapters: suspect statements,
// the murderer always lies)
//
// Everything from the plain template, plus the statement machinery:
//   statement <speaker> <claim>   — the testimony, declared ONCE
// The panel shows each claim's truth in the current world, and
// assembles the liar certificate automatically: exactly one speaker's
// claim false = the murderer, derived. Each statement also gets a
// PAIR of hypothesis blocks (its true-world and false-world
// CONSEQUENCES), and the active line composes your theory — one
// _false, the rest _true. Solved = checks green, goals bound,
// certificate sole.
theme paper
view top
time found 0

room unknown size(8 2.5 5) at(-8 0 -8) color(black)

set rooms
room room_one color(green)
room room_two west-of(room_one) color(coral)
room room_three west-of(room_two) color(tan)
end

//victim: found in ___ — write it down before the clues
person body at(unknown 3.5 .6) color(grey)
turn body to(90 0 0) over(0)
//walk body to(room_one) over(0)

set suspects
person suspect_one at(unknown -3 -1) color(firebrick)
person suspect_two at(unknown -2 -1) color(steelblue)
person suspect_three at(unknown -1 -1) color(seagreen)
end

set weapons
box weapon_one size(0.3 0.1 0.2) at(unknown -3 1) color(firebrick)
box weapon_two size(0.3 0.1 0.2) at(unknown -2 1) color(steelblue)
box weapon_three size(0.3 0.1 0.2) at(unknown -1 1) color(seagreen)
end

// ---- CLUES (the un-spoken ones) --------------------------------------
// gates that can go red, or pair_up constraints — see template-murdle

// ---- STATEMENTS ------------------------------------------------------
// declare each statement ONCE: speaker + the LITERAL claim (goal
// syntax — what the words assert about the world, not who they
// implicate). The panel shows each claim's truth live, and derives
// "exactly one liar" below your goals — no certificate to hand-write.
// Replace these placeholders with your puzzle's statements:

statement suspect_one \+ present_at(suspect_one, room_one, 0)
statement suspect_two \+ present_at(weapon_one, room_two, 0)
statement suspect_three present_at(weapon_two, room_one, 0)

// each statement still gets its PAIR of hypothesis blocks — the
// true-world and false-world CONSEQUENCES are yours to model
// (a claim's truth is derived; what it FORCES is deduction):

hypothesis one_true
// suspect_one's claim holds — what follows? place people, take things
end
hypothesis one_false
// the negation holds — what follows? (lies are informative)
end

hypothesis two_true
end
hypothesis two_false
end

hypothesis three_true
end
hypothesis three_false
end

// your theory: one liar, everyone else truthful. Swap and recompile —
// each selection is one world; the checks kill the impossible ones,
// and the statement panel shows exactly one false claim when your
// world is consistent.
active one_true two_true three_true

// ---- CERTIFICATES — green + bound = solved ---------------------------
?- pair_up_scene(suspects, weapons, [], P)
?- one_each(suspects, rooms, found)
?- one_each(weapons, rooms, found)

// the full verdict adds geometry: the liar is AT the scene
//?- where(body, found, R), exactly_one(suspects, R, found, Killer),
//   exactly_one(weapons, R, found, Weapon)
